{
    "name": "ecommerce-frontend",
    "version": "0.0.0",
    "scripts": {
        "ng": "ng",
        "start": "ng serve --verbose",
        "build:production": "ng build --verbose --clear-screen --configuration production --optimization --subresource-integrity",
        "build:development": "ng build --verbose --clear-screen --configuration development --subresource-integrity",
        "watch": "ng build --verbose --clear-screen --watch --configuration development",
        "test:production": "ng test --configuration production --progress",
        "test:development": "ng test --configuration development --progress",
        "lint": "ng lint",
        "lint:fix": "ng lint --fix",
        "format": "prettier --write \"src/**/*.{ts,html,scss,json}\"",
        "format:check": "prettier --check \"src/**/*.{ts,html,scss,json}\""
    },
    "prettier": {
        "printWidth": 100,
        "singleQuote": true,
        "overrides": [
            {
                "files": "*.html",
                "options": {
                    "parser": "angular"
                }
            }
        ]
    },
    "private": true,
    "dependencies": {
        "@angular/common": "^22.1.1",
        "@angular/compiler": "^22.1.1",
        "@angular/core": "^22.1.1",
        "@angular/forms": "^22.1.1",
        "@angular/platform-browser": "^22.1.1",
        "@angular/router": "^22.1.1",
        "@ng-bootstrap/ng-bootstrap": "19.0.1",
        "@popperjs/core": "^2.11.8",
        "bootstrap": "5.3.8",
        "rxjs": "~7.8.2",
        "tslib": "^2.8.1"
    },
    "devDependencies": {
        "@angular-eslint/builder": "^20.7.0",
        "@angular-eslint/eslint-plugin": "^20.7.0",
        "@angular-eslint/eslint-plugin-template": "^20.7.0",
        "@angular-eslint/schematics": "^20.7.0",
        "@angular-eslint/template-parser": "^20.7.0",
        "@angular/build": "^22.1.3",
        "@angular/cli": "^22.1.3",
        "@angular/compiler-cli": "^22.1.1",
        "@angular/localize": "^22.1.1",
        "@types/jasmine": "~5.1.15",
        "@typescript-eslint/eslint-plugin": "^8.61.0",
        "@typescript-eslint/parser": "^8.61.0",
        "eslint": "^9.39.4",
        "eslint-plugin-prettier": "^5.5.6",
        "jasmine-core": "~5.9.0",
        "karma": "~6.4.4",
        "karma-chrome-launcher": "~3.2.0",
        "karma-coverage": "~2.2.1",
        "karma-jasmine": "~5.1.0",
        "karma-jasmine-html-reporter": "~2.1.0",
        "prettier": "^3.8.4",
        "typescript": "~6.0.3"
    }
}
